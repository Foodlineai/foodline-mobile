# Copy to .env.local (git-ignored). Restart with `npx expo start --clear`.

# --- Live ERP ---
# Same Supabase project as the web ERP. Publishable key is browser-safe by design;
# RLS + the WorkOS session are what protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://fzavogttmmyyeuguvmry.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WorkOS AuthKit owns the session; Supabase trusts its JWT as a third-party provider.
# Client id matches the web ERP's WORKOS_CLIENT_ID (Foodline Staging).
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_01M1VJMZJ03MEPN0VB9SC86TV1
EXPO_PUBLIC_WORKOS_AUTH_DOMAIN=https://api.workos.com
EXPO_PUBLIC_ERP_BASE_URL=https://erp.foodlineai.com

EXPO_PUBLIC_APP_ENV=development
